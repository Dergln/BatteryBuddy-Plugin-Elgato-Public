{
  "name": "batterybuddy-plugin-elgato",
  "version": "1.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "A Stream Deck plugin for displaying BatteryBuddy device battery status.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "validate": "npm run build && streamdeck validate com.dergln.batterybuddy.streamdeck.sdPlugin --no-update-check",
    "pack": "npm run validate && streamdeck pack com.dergln.batterybuddy.streamdeck.sdPlugin --output dist --no-update-check --force"
  },
  "dependencies": {
    "@elgato/streamdeck": "3.0.4"
  },
  "devDependencies": {
    "@elgato/cli": "1.10.4",
    "@rollup/plugin-commonjs": "29.0.3",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-typescript": "12.3.1",
    "@types/node": "24.19.2",
    "rollup": "4.67.5",
    "tslib": "2.9.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@elgato/utils": {
      "zod": "4.6.7"
    }
  }
}
